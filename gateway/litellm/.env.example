# Gateway authentication: generate a long random value; never commit the real .env.
LITELLM_MASTER_KEY=sk-dv-change-this-to-a-long-random-secret
# Keep the gateway loopback-only by default. Set 0.0.0.0 only behind a firewall/reverse proxy.
LITELLM_BIND=127.0.0.1

# Optional OpenAI-compatible FreeLLMAPI gateway
FREELLMAPI_BASE_URL=https://YOUR-FREELLMAPI-ENDPOINT/v1
FREELLMAPI_API_KEY=replace-me
FREELLMAPI_MODEL=auto

# Optional NVIDIA NIM
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=replace-me
NVIDIA_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1

# Optional OpenRouter
OPENROUTER_API_KEY=replace-me
OPENROUTER_MODEL=openai/gpt-oss-120b

# Optional Ollama; use host.docker.internal when Ollama runs on the Docker host.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5-coder:7b
